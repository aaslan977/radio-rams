{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* strict включён явно: в TS 6 он и так по умолчанию, но конфиг не должен
       молча зависеть от версии компилятора. noUncheckedIndexedAccess осознанно
       не включаем — он даёт 14 ошибок, в основном на заведомо безопасной
       индексации в покадровом цикле отрисовки эквалайзера, где проверки на
       undefined только зашумили бы горячий код. */
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "pwa-assets.config.ts"]
}
